<?xml version="1.0"?>
<model>
  <name>ugv_pro_audio</name>
  <version>1.0</version>
  <sdf version="1.5">model.sdf</sdf>
  <author>
    <name>UGV Pro Audio Team</name>
    <email>ugv@waveshare.com</email>
  </author>
  <description>
    Waveshare 6-wheel UGV Rover Pro Audio configuration with:
    - True 6-wheel skid-steer physics (all 6 wheels driven with anisotropic ODE tire friction)
    - 16-channel 360-degree 3D LiDAR (/scan_cloud) + 2D LaserScan (/scan)
    - 2-axis Pan-Tilt camera turret (pt_base_link, pt_link1, pt_link2, pt_camera_link)
    - Front RGB-D depth camera (3d_camera_link)
    - Omnidirectional 5-microphone 3D acoustic array (mic_fl, mic_fr, mic_rl, mic_rr, mic_top)
    - Realistic 6-axis IMU with bias drift (/imu) and GNSS receiver (/gps/fix)
  </description>
</model>
