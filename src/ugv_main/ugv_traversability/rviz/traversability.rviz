Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
    - Class: rviz_default_plugins/Map
      Name: Traversability cost
      Enabled: true
      Topic:
        Value: /terrain_traversability/grid
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.7
      Draw Behind: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Elevation (colour = cost)
      Enabled: true
      Topic:
        Value: /terrain_traversability/elevation_cloud
      Style: Boxes
      Size (m): 0.05
      Color Transformer: Intensity
      Use rainbow: true
      Autocompute Intensity Bounds: false
      Min Intensity: 0
      Max Intensity: 100
    - Class: rviz_default_plugins/PointCloud2
      Name: Lethal cells
      Enabled: false
      Topic:
        Value: /terrain_traversability/obstacles
      Style: Boxes
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 255; 0; 0
    - Class: rviz_default_plugins/PointCloud2
      Name: Lidar
      Enabled: false
      Topic:
        Value: /scan_cloud
      Style: Points
      Size (Pixels): 2
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Pitch: 0.9
      Yaw: 3.9
      Target Frame: base_footprint
