    </link>

    <!-- 4. Right Front Wheel -->
    <link name='right_up_wheel_link'>
      <pose relative_to='right_up_wheel_link_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 1.5708 0 0</pose>
