<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ugv_coqui_behavior</name>
  <version>0.1.0</version>
  <description>Autonomous Coqui Frog Exploration, Acoustic Tracking &amp; Triangulation, 2-Axis Pan-Tilt Camera Aiming/Photography, and Return-to-Origin Behavior for ugv_pro_audio.</description>
  <maintainer email="ugv@waveshare.com">ugv</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>cv_bridge</depend>
  <depend>ugv_audio</depend>
  <depend>lifecycle_msgs</depend>
  <depend>action_msgs</depend>
  <depend>builtin_interfaces</depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>ugv_traversability</exec_depend>
  <exec_depend>ugv_gazebo</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
