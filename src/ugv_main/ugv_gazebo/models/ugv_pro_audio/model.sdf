          </bounce>
          <friction>
            <torsional>
              <coefficient>0.25</coefficient>
              <use_patch_radius>1</use_patch_radius>
              <patch_radius>0.012</patch_radius>
              <surface_radius>0.040</surface_radius>
              <ode>
                <slip>0.0</slip>
